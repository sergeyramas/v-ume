      "css": ":host{--page:#E3E5E2;--alu:#F2F3F1;--ink:#16181B;--ink-2:#4A4F55;--mute:#62676D;--line:#C8CBC7;--line-2:#DADDD9;--white:#FFFFFF;--h-on:#7FA2F5;--t-on:#41C48F;--u-on:#ECAE42;--i-on:#ECEEEB;--op-on:#A9AEB4;--housing:#D3D6D2;--housing-edge:#B5B9B4;--flap-up:#25282D;--flap-dn:#1B1D21;--hinge:#08090A;--pin:#9AA0A6;--red:#E5322D;--red-ink:#C9261F;font-family:'Golos Text',system-ui,sans-serif;font-variant-numeric:tabular-nums;} .ds-row{display:flex;gap:6px;flex-wrap:wrap}.ds-stamp{display:inline-block;font:700 11px/1.3 'Golos Text',system-ui,sans-serif;letter-spacing:.07em;text-transform:uppercase;padding:3px 7px 2px;border:1px solid var(--ink);color:var(--ink);white-space:nowrap}.ds-fill{background:var(--ink);color:var(--alu)}.ds-now{background:var(--red-ink);border-color:var(--red-ink);color:#fff}.ds-off{border-color:var(--line);color:var(--mute)}.ds-gone{border-color:var(--line);color:var(--mute);text-decoration:line-through;text-decoration-thickness:1px}"
