      "css": ":host{--page:#E3E5E2;--alu:#F2F3F1;--ink:#16181B;--ink-2:#4A4F55;--mute:#62676D;--line:#C8CBC7;--line-2:#DADDD9;--white:#FFFFFF;--h-on:#7FA2F5;--t-on:#41C48F;--u-on:#ECAE42;--i-on:#ECEEEB;--op-on:#A9AEB4;--housing:#D3D6D2;--housing-edge:#B5B9B4;--flap-up:#25282D;--flap-dn:#1B1D21;--hinge:#08090A;--pin:#9AA0A6;--red:#E5322D;--red-ink:#C9261F;font-family:'Golos Text',system-ui,sans-serif;font-variant-numeric:tabular-nums;} .ds-btn-go{border:1px solid var(--ink);background:var(--ink);color:var(--alu);padding:12px 20px;font:600 16px/1.45 'Golos Text',system-ui,sans-serif;border-radius:2px;min-height:48px;cursor:pointer;display:inline-flex;align-items:center;gap:10px}.ds-btn-go:hover{background:#2B2F34}.ds-btn-go:focus-visible{outline:2px solid var(--ink);outline-offset:3px}.ds-kbd{font:inherit;font-size:12px;font-weight:600;border:1px solid currentColor;padding:0 5px;border-radius:2px;opacity:.8}"
