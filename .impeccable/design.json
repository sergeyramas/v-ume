  "components": [
    {
      "name": "Табло с лампой",
      "kind": "custom",
      "refersTo": "board",
      "description": "Перекидное табло: цифры по разрядам, красная рамка с лампой на том, о чём речь сейчас.",
      "html": "<div class=\"ds-board\"><span class=\"ds-tile\"><span class=\"ds-up\"><span class=\"ds-c-t\">8</span></span><span class=\"ds-dn\"><span class=\"ds-c-t\">8</span></span></span><span class=\"ds-tile\"><span class=\"ds-up\"><span class=\"ds-c-u\">7</span></span><span class=\"ds-dn\"><span class=\"ds-c-u\">7</span></span></span><span class=\"ds-tile\"><span class=\"ds-up\"><span class=\"ds-c-op\">+</span></span><span class=\"ds-dn\"><span class=\"ds-c-op\">+</span></span></span><span class=\"ds-tile\"><span class=\"ds-up\"><span class=\"ds-c-t\">9</span></span><span class=\"ds-dn\"><span class=\"ds-c-t\">9</span></span></span><span class=\"ds-tile\"><span class=\"ds-up\"><span class=\"ds-c-u\">8</span></span><span class=\"ds-dn\"><span class=\"ds-c-u\">8</span></span></span><span class=\"ds-lit\" style=\"left:168px;width:111px\"></span></div>",
      "css": ":host{--page:#E3E5E2;--alu:#F2F3F1;--ink:#16181B;--ink-2:#4A4F55;--mute:#62676D;--line:#C8CBC7;--line-2:#DADDD9;--white:#FFFFFF;--h-on:#7FA2F5;--t-on:#41C48F;--u-on:#ECAE42;--i-on:#ECEEEB;--op-on:#A9AEB4;--housing:#D3D6D2;--housing-edge:#B5B9B4;--flap-up:#25282D;--flap-dn:#1B1D21;--hinge:#08090A;--pin:#9AA0A6;--red:#E5322D;--red-ink:#C9261F;font-family:'Golos Text',system-ui,sans-serif;font-variant-numeric:tabular-nums;} .ds-board{--th:72px;position:relative;display:inline-flex;gap:6px;padding:12px;background:var(--housing);border:1px solid var(--housing-edge);border-radius:5px}.ds-tile{position:relative;display:block;width:calc(var(--th)*.66);height:var(--th);font-size:calc(var(--th)*.72);font-weight:700;letter-spacing:-.02em;border-radius:4px;background:var(--flap-dn)}.ds-tile::after{content:'';position:absolute;left:0;right:0;top:calc(50% - 1px);height:2px;background:var(--hinge);z-index:4}.ds-tile::before{content:'';position:absolute;left:-2px;right:-2px;top:calc(50% - 4px);height:8px;z-index:5;background:linear-gradient(to right,var(--pin) 0 2px,transparent 2px calc(100% - 2px),var(--pin) calc(100% - 2px))}.ds-up,.ds-dn{position:absolute;left:0;right:0;height:50%;overflow:hidden}.ds-up{top:0;border-radius:4px 4px 0 0;background:var(--flap-up)}.ds-dn{bottom:0;border-radius:0 0 4px 4px;background:var(--flap-dn)}.ds-up>span,.ds-dn>span{display:block;height:var(--th);line-height:var(--th);text-align:center;color:var(--i-on)}.ds-dn>span{transform:translateY(-50%)}.ds-c-h{color:var(--h-on)!important}.ds-c-t{color:var(--t-on)!important}.ds-c-u{color:var(--u-on)!important}.ds-c-op{color:var(--op-on)!important;font-weight:500}.ds-lit{position:absolute;pointer-events:none;border:2px solid var(--red);border-radius:6px;z-index:6;top:7px;height:calc(var(--th) + 10px);transition:left .18s,width .18s}.ds-lit::before{content:'';position:absolute;top:-14px;left:50%;width:9px;height:9px;margin-left:-4.5px;border-radius:50%;background:var(--red)}"
    },
    {
      "name": "Кнопка",
      "kind": "button",
      "refersTo": "button",
      "description": "Обычная кнопка: контур графитом, наведение белым.",
      "html": "<button class=\"ds-btn\">Назад</button>",
      "css": ":host{--page:#E3E5E2;--alu:#F2F3F1;--ink:#16181B;--ink-2:#4A4F55;--mute:#62676D;--line:#C8CBC7;--line-2:#DADDD9;--white:#FFFFFF;--h-on:#7FA2F5;--t-on:#41C48F;--u-on:#ECAE42;--i-on:#ECEEEB;--op-on:#A9AEB4;--housing:#D3D6D2;--housing-edge:#B5B9B4;--flap-up:#25282D;--flap-dn:#1B1D21;--hinge:#08090A;--pin:#9AA0A6;--red:#E5322D;--red-ink:#C9261F;font-family:'Golos Text',system-ui,sans-serif;font-variant-numeric:tabular-nums;} .ds-btn{border:1px solid var(--ink);background:transparent;color:var(--ink);padding:12px 20px;font:600 16px/1.45 'Golos Text',system-ui,sans-serif;border-radius:2px;min-height:48px;cursor:pointer;display:inline-flex;align-items:center;gap:10px}.ds-btn:hover{background:var(--white)}.ds-btn:focus-visible{outline:2px solid var(--ink);outline-offset:3px}.ds-btn:disabled{border-color:var(--line);color:var(--mute);background:transparent;cursor:default}"
    },
